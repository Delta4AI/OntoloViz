# OntoloViz web build/dev configuration (read by vite.config.ts).
#
# All optional. To persist a value, copy it into a gitignored file:
#   - builds:  web/.env.production.local
#   - dev:     web/.env.local
# An explicit env var on the command line overrides the file.

# Deployment base path. Default is relative ("./") — the build then works at
# the root OR any reverse-proxy sub-path with no config. Set an absolute path
# (must start and end with "/") only to force one, e.g. assets on a CDN.
# VITE_BASE=./

# Vite dev server port. Override if 5173 is already taken locally.
VITE_DEV_PORT=5173

# Where `make dev` proxies /api — the backend's address in development.
VITE_API_TARGET=http://127.0.0.1:8000
